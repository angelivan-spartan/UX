#!/bin/bash
if [[ $EUID -ne 0 ]]; then
   echo -e "\e[1;31mThis program must be run as root" 
   exit 1
fi

apt -y update
apt -y full-upgrade
cp -f /usr/src/UX//special/p8/usr/lib/os-release /usr/lib/os-release
apt -y install vim wget exfat-fuse ntfs-3g tmux python3 python3-pip libncurses5 libxext-dev libncurses5-dev libx11-dev libxpm-dev libxrandr-dev libgbm1 libgl1-mesa-dri libegl1-mesa libinput10 libice6 libsm6 htop zip p7zip-full p7zip net-tools fbi parted proxmox-ve corosync-qdevice dotnet-sdk-10.0
cp -f -r /usr/src/UX/special/p8/usr/* /usr/


if [[ /usr/bin/dotnet ]]; then
echo -e "" 
else
echo "Config DotNet..."
if grep -q 'export DOTNET_CLI_TELEMETRY_OPTOUT=' /etc/profile;  then
  echo 'Already added link to profile'
else
  echo 'export DOTNET_CLI_TELEMETRY_OPTOUT=1' >> /etc/profile
fi
export DOTNET_CLI_TELEMETRY_OPTOUT=1
fi