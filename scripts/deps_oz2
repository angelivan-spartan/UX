#!/bin/bash
if [[ $EUID -ne 0 ]]; then
   echo -e "\e[1;31mThis program must be run as root" 
   exit 1
fi

apt -y update
apt -y full-upgrade
cp -f /usr/src/UX//special/oz2/usr/lib/os-release /usr/lib/os-release
apt -y install vim exfat-fuse ntfs-3g tmux python3 python3-pip libncurses5 libgbm1 libgl1-mesa-dri libegl1-mesa libinput10 libice6 libsm6 fbi samba avahi-daemon libncurses5-dev parted
pip3 install --upgrade OPi.GPIO