#!/bin/bash
if [[ $EUID -ne 0 ]]; then
   echo -e "\e[1;31mThis program must be run as root" 
   exit 1
fi

apt -y update
apt -y full-upgrade
cp -f /usr/src/UX//special/p9/usr/lib/os-release /usr/lib/os-release
apt -y install vim wget exfat-fuse ntfs-3g tmux python3 python3-pip htop zip p7zip-full p7zip net-tools fbi parted proxmox-ve corosync-qdevice
cp -f -r /usr/src/UX/special/p9/usr/* /usr/
