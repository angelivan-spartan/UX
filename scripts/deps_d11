#!/bin/bash
if [[ $EUID -ne 0 ]]; then
   echo -e "\e[1;31mThis program must be run as root" 
   exit 1
fi

wget -O /usr/share/keyrings/microsoft-archive-keyring.gpg http://uxarchive.mier.com.mx/ms/microsoft-archive-keyring-pre.gpg
apt -y update
apt -y full-upgrade
cp -f /usr/src/UX/special/d11/usr/lib/os-release /usr/lib/os-release
apt -y install vim wget exfat-fuse ntfs-3g tmux libncurses5 htop zip p7zip-full p7zip net-tools fbi parted
apt -y autoremove